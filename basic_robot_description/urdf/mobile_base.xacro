<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.8" />
    <xacro:property name="base_width" value="0.654" />
    <xacro:property name="base_height" value="0.25" />
    <xacro:property name="wheel_radius" value="0.111" />
    <xacro:property name="wheel_length" value="0.073" />
    <xacro:property name="wheel_dist" value="0.444" />

    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 0.25" rpy="0 0 0" />
            <material name="blue" />
        </visual>
    </link>

    <xacro:macro name="wheel_link" params="prefix x y">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="grey" />
            </visual>
        </link>
        <joint name="base_${prefix}_wheel_joint" type="continuous">
            <parent link="base_link" />
            <child link="${prefix}_wheel_link" />
            <origin xyz="${x} ${y} 0" rpy="0 0 0" />
            <axis xyz="0 1 0" />
        </joint>
    </xacro:macro>

    <!-- Positive x is the front; positive y is the left side. -->
    <xacro:wheel_link prefix="front_right" x="${wheel_dist}" y="${-(base_width + wheel_length) / 2.0}" />
    <xacro:wheel_link prefix="middle_right" x="0" y="${-(base_width + wheel_length) / 2.0}" />
    <xacro:wheel_link prefix="rear_right" x="${-wheel_dist}" y="${-(base_width + wheel_length) / 2.0}" />
    <xacro:wheel_link prefix="front_left" x="${wheel_dist}" y="${(base_width + wheel_length) / 2.0}" />
    <xacro:wheel_link prefix="middle_left" x="0" y="${(base_width + wheel_length) / 2.0}" />
    <xacro:wheel_link prefix="rear_left" x="${-wheel_dist}" y="${(base_width + wheel_length) / 2.0}" />

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

</robot>
